import FreeCAD as App, FreeCADGui as Gui, Part, MeshPart
from FreeCAD import Vector as V
from PySide import QtCore
import os, json, math, traceback

ROOT='/home/ubuntu/github/structure/surfer_figurine_artboard_v3'
SCALE=150.0/180.0
FIT=.20/SCALE
AXIAL=.30/SCALE
HEAD_YAW=-8.0
STANDING_LEAN_DEG=8.0
# Calibrated against the board normal, after removing the board's image roll.
RAW_LEAN_TANGENT=(31.0-(-9.5))/(165.0-7.0)
POSE_SHEAR=RAW_LEAN_TANGENT-math.tan(math.radians(STANDING_LEAN_DEG))
PINK=(.79,.30,.43); RED=(.73,.17,.29); NAVY=(.115,.145,.205)
SKIN=(.76,.51,.40); BLACK=(.065,.068,.076); GRAY=(.40,.405,.40)
WHITE=(.92,.90,.85); GOLD=(.60,.47,.25)
LOG=ROOT+'/source/build.log'
def log(s):
    with open(LOG,'a') as f:f.write(str(s)+'\n')
    App.Console.PrintMessage(str(s)+'\n')
if '_command_timer' in globals():_command_timer.stop()
def poll_commands():
    path=ROOT+'/source/request.py'
    if os.path.exists(path):
        code=open(path).read();os.unlink(path)
        try:exec(compile(code,path,'exec'),globals())
        except Exception:log(traceback.format_exc())
_command_timer=QtCore.QTimer();_command_timer.timeout.connect(poll_commands);_command_timer.start(1000)

def box(x,y,z,dx,dy,dz):return Part.makeBox(dx,dy,dz,V(x,y,z))
def ellipsoid(c,r):
    m=App.Matrix();m.A11=r[0];m.A22=r[1];m.A33=r[2]
    s=Part.makeSphere(1).transformGeometry(m);s.translate(V(*c));return s
def ellipse_wire(c,rx,ry,normal=V(0,0,1)):
    edge=Part.Ellipse(V(),max(rx,ry),min(rx,ry)).toShape()
    rot=App.Rotation(V(0,0,1),normal)
    if ry>rx:rot=rot.multiply(App.Rotation(V(0,0,1),90))
    edge.Placement=App.Placement(V(*c),rot);return Part.Wire([edge])
def loft(rows):return Part.makeLoft([ellipse_wire(*r) for r in rows],True,False)
def zloft(rows):return loft([(c,rx,ry,V(0,0,1)) for c,rx,ry in rows])
def union(shapes):
    s=shapes[0]
    for other in shapes[1:]:s=s.fuse(other)
    return s
def d_pin(c,r,h,axis=V(0,0,1),clearance=0):
    rr=r+clearance;s=Part.makeCylinder(rr,h)
    s=s.cut(box(r*.72+clearance,-rr-1,-1,rr+2,2*rr+2,h+2))
    if not clearance:
        edges=[e for e in s.Edges if len(e.Vertexes)>0 and (all(abs(v.Point.z)<1e-5 for v in e.Vertexes) or all(abs(v.Point.z-h)<1e-5 for v in e.Vertexes))]
        try:s=s.makeChamfer(.20/SCALE,edges)
        except Exception:pass
    s.Placement=App.Placement(V(*c),App.Rotation(V(0,0,1),axis));return s

def cloth_wire(c,rx,front,back,power=2.1,kind='plain',phase=0):
    pts=[];z=c[2]
    for i in range(64):
        a=2*math.pi*i/64;co=math.cos(a);si=math.sin(a)
        ux=math.copysign(abs(co)**(2/power),co);uy=math.copysign(abs(si)**(2/power),si)
        rib=0;fold=0
        if kind=='shirt':
            hem=math.exp(-((z-84)/3.5)**2)
            rib=.19*hem*math.cos(24*a)
            if si<0:
                fade=math.exp(-((z-97)/17)**2)
                fold=.65*fade*(math.exp(-((ux+.62+.002*(z-96))/.11)**2)-.68*math.exp(-((ux-.57)/.12)**2))
                fold+=.30*math.exp(-((z-132)/9)**2)*math.cos(a*5)
        if kind=='pants':
            rib=.17*math.exp(-((z-21)/3)**2)*math.cos(18*a)
            fold=.40*math.exp(-((z-52)/8)**2)*math.sin(3*a+phase)
            fold+=.30*math.exp(-((z-26)/7)**2)*math.cos(4*a+phase)
        rr=rx+rib
        depth=(front if si<0 else back)+rib+(fold if si<0 else .15*fold)
        pts.append(V(c[0]+rr*ux,c[1]+depth*uy,c[2]))
    curve=Part.BSplineCurve();curve.interpolate(Points=pts,PeriodicFlag=True)
    return Part.Wire([curve.toShape()])
def cloth_loft(rows,power=2.1,kind='plain',phase=0):
    return Part.makeLoft([cloth_wire(c,rx,fr,ba,power,kind,phase) for c,rx,fr,ba in rows],True,False)
def interp(rows,z):
    for a,b in zip(rows,rows[1:]):
        if a[0][2]<=z<=b[0][2]:
            t=(z-a[0][2])/(b[0][2]-a[0][2])
            return tuple(a[0][j]+t*(b[0][j]-a[0][j]) for j in range(3)),*[a[j]+t*(b[j]-a[j]) for j in range(1,4)]
    return rows[0] if z<rows[0][0][2] else rows[-1]
def surface_front(rows,x,z,power=2.0):
    c,rx,fr,ba=interp(rows,z);u=min(.999,abs((x-c[0])/rx))
    return c[1]-fr*(1-u**power)**(1/power)
def tube(points,r):
    curve=Part.BSplineCurve();curve.interpolate(Points=[V(*p) for p in points]);edge=curve.toShape()
    tangent=edge.tangentAt(edge.FirstParameter)
    profile=Part.Wire([Part.makeCircle(r,V(*points[0]),tangent)])
    return Part.Wire([edge]).makePipeShell([profile],True,False)
def safe_detail(shape,detail,tag,operation='cut'):
    candidate=shape.cut(detail) if operation=='cut' else shape.fuse(detail)
    if candidate.isValid() and len(candidate.Solids)==1 and candidate.Volume>0:return candidate
    log('Detail rejected by solid check: '+tag);return shape
def head_turn(shape):
    s=shape.copy();s.rotate(V(29,0,150.5),V(0,0,1),HEAD_YAW);return s

def put(name,label,shape,color,notes,paint=None):
    if not shape.isValid() or len(shape.Solids)!=1 or shape.Volume<=0:
        log([(s.Volume,str(s.BoundBox)) for s in shape.Solids])
        raise RuntimeError(name+' invalid or disconnected')
    s=shape.copy()
    pose_matrix=App.Matrix();pose_matrix.A13=-POSE_SHEAR;pose_matrix.A14=POSE_SHEAR*7
    if name not in ['P01_Board_Left','P02_Board_Right']:s=s.transformGeometry(pose_matrix)
    s.scale(SCALE)
    if not s.isValid() or len(s.Solids)!=1:raise RuntimeError(name+' invalid after uniform scaling')
    obj=doc.addObject('PartDesign::Feature',name);obj.Label=label;obj.Shape=s
    obj.addProperty('App::PropertyString','AssemblyInstructions','Print').AssemblyInstructions=notes
    obj.addProperty('App::PropertyLength','RadialFitClearance','Print').RadialFitClearance=.20
    obj.addProperty('App::PropertyString','VersionNotes','Reference').VersionNotes='V3: curved artistic skateboard; photo landmarks, adult proportions, leaning pose, sculpted clothing and face; 150mm nominal height'
    obj.ViewObject.ShapeColor=color;obj.ViewObject.DisplayMode='Flat Lines';obj.ViewObject.LineColor=(.16,.16,.18);obj.ViewObject.LineWidth=.5
    def unpose(p):
        p=p/SCALE
        return p if name in ['P01_Board_Left','P02_Board_Right'] else V(p.x+POSE_SHEAR*(p.z-7),p.y,p.z)
    if paint:
        if name in ['P01_Board_Left','P02_Board_Right']:
            obj.ViewObject.DiffuseColor=[(.89,.66,.27) if any(paint(unpose(p))!=RED for p in [f.CenterOfMass]+[v.Point for v in f.Vertexes]) else RED for f in s.Faces]
        else:obj.ViewObject.DiffuseColor=[paint(unpose(f.CenterOfMass)) for f in s.Faces]
    assembly.addObject(obj);parts.append(obj);base_colors[name]=list(color)
    log('Created '+name+' volume '+str(round(s.Volume,2)))
    return obj

